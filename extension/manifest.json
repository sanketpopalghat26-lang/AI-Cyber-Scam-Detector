{
  "manifest_version": 3,
  "name": "AI Cyber Scam Detector",
  "version": "0.1.0",
  "description": "Detect phishing and scam content on webpages and selected text.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Scam Detector"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ]
}
