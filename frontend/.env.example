# =============================================================================
# Frontend Environment Configuration
# =============================================================================

# Base URL for the backend API
# In development with docker-compose, the backend is reachable at this address.
# For production builds, set this at build time to the public API endpoint.
VITE_API_BASE=http://localhost:8000

# Optional: enable/disable specific features
VITE_ENABLE_ANALYTICS=false
VITE_APP_NAME=AI Cyber Scam Detector
