# =============================================================================
# Environment Configuration — AI Cyber Scam Detector
# Copy to .env and fill in real values. NEVER commit the .env file.
# =============================================================================

# --- Application ---
APP_ENV=development                # development | testing | production
APP_VERSION=2.0.0
DEBUG=false
LOG_LEVEL=INFO

# --- Security (CRITICAL) ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_MIN_LENGTH=12

# CORS: comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# --- Database ---
# PostgreSQL (production)
DATABASE_URL=postgresql://scam_user:CHANGE_ME@localhost:5432/scamdb
# SQLite (development only)
# DATABASE_URL=sqlite:///./dev.db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_SSLMODE=require

# --- Redis / Cache ---
REDIS_URL=
REDIS_PASSWORD=
CACHE_DEFAULT_TTL=300
CACHE_PREDICTION_TTL=600

# --- Model ---
MODEL_PATH=/app/model/best_model.joblib

# --- Observability ---
OTLP_ENDPOINT=
PROMETHEUS_MULTIPROC_DIR=
SLOW_REQUEST_THRESHOLD_MS=1000

# --- Alerting ---
ALERT_WEBHOOK_URL=

# --- Rate Limiting ---
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60

# --- Feature Flags ---
ENABLE_METRICS=true
ENABLE_TRACING=false
ENABLE_CACHE=true
ENABLE_RATE_LIMITING=true
ENABLE_THREAT_INTEL=true
ENABLE_EXPLAINABILITY=true
ENABLE_INVESTIGATION=true

# --- Frontend (build-time) ---
# VITE_API_BASE=http://localhost:8000
