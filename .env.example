# =============================================================================
# AI Cyber Scam Detector - Environment Configuration
# =============================================================================
# IMPORTANT: Never commit .env to version control. Use this template only.
# For production, set all values as environment variables on the deployment platform.
# NEVER commit real secrets to the repository.

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_NAME=AI Cyber Scam Detector
APP_VERSION=2.0.0
# Set to 'production' for production deployments
APP_ENV=development
# Set to false for production
DEBUG=false
LOG_LEVEL=INFO

# =============================================================================
# BACKEND SETTINGS
# =============================================================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# =============================================================================
# ML MODEL SETTINGS
# =============================================================================
# Path to trained model artifact (in Docker: /app/model/best_model.pkl)
MODEL_PATH=models/exports/best_model.pkl

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# DEVELOPMENT: SQLite (default for local development only)
DATABASE_URL=sqlite:///./dev.db

# PRODUCTION: PostgreSQL configuration
# Change these credentials to secure values
# DATABASE_URL=postgresql://scam_user:YOUR_SECURE_PASSWORD@db:5432/scamdb
#
# Environment variables for Docker Compose:
# POSTGRES_USER=scam_user
# POSTGRES_PASSWORD=YOUR_SECURE_PASSWORD_HERE
# POSTGRES_DB=scamdb
# DB_PORT=5432

# Database connection pool settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_ECHO=false

# =============================================================================
# SECURITY SETTINGS - CHANGE THESE IN PRODUCTION!
# =============================================================================
# WARNING: Never use default value in production!
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-secret-key-do-not-use-in-prod

# JWT Configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ISSUER=ai-cyber-scam-detector
JWT_AUDIENCE=ai-cyber-scam-detector-api

# Account Lockout Policy
ACCOUNT_LOCKOUT_THRESHOLD=5
ACCOUNT_LOCKOUT_WINDOW_SECONDS=900
ACCOUNT_LOCKOUT_DURATION_SECONDS=900

# Password Policy
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_SPECIAL=true
PASSWORD_REQUIRE_UPPER=true
PASSWORD_REQUIRE_DIGIT=true

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60

# =============================================================================
# CORS SETTINGS
# =============================================================================
# Development: Allow localhost ports
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# Production: Set to your frontend domain only
# CORS_ORIGINS=https://your-frontend-domain.com

# =============================================================================
# CACHE SETTINGS
# =============================================================================
# Leave empty for in-memory cache (development)
REDIS_URL=
# Production: Use Redis for distributed caching
# REDIS_URL=redis://:password@redis-host:6379/0

CACHE_DEFAULT_TTL=300
CACHE_PREDICTION_TTL=600

# =============================================================================
# PRODUCTION DEPLOYMENT CHECKLIST
# =============================================================================
# Before deploying to production:
# [ ] Set APP_ENV=production
# [ ] Set DEBUG=false
# [ ] Generate and set SECRET_KEY to secure random value
# [ ] Configure DATABASE_URL to production PostgreSQL instance
# [ ] Set POSTGRES_PASSWORD to secure credentials
# [ ] Set CORS_ORIGINS to your production domain only
# [ ] Configure Redis for distributed cache (if load balancing)
# [ ] Set up SSL/TLS certificates
# [ ] Enable audit logging
# [ ] Review all security settings
# [ ] Test with production configuration before deploying
CACHE_PREDICTION_TTL=600

# --- Rate Limiting ---
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60

# --- Feature Flags ---
ENABLE_METRICS=true
ENABLE_TRACING=false
ENABLE_CACHE=true
ENABLE_RATE_LIMITING=true
ENABLE_THREAT_INTEL=true
ENABLE_EXPLAINABILITY=true
ENABLE_INVESTIGATION=true
ENABLE_MONITORING=true
ENABLE_CHAT=true

# --- Frontend ---
# Base URL for the backend API (used by the frontend)
VITE_API_BASE=http://localhost:8000
VITE_APP_NAME=AI Cyber Scam Detector
VITE_ENABLE_ANALYTICS=false